{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jworks",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jworks-db",
      "database_id": "e714c771-188d-4411-88ee-46d218d2f539",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "jworks-files"
    }
  ]
}
